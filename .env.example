# Azure OpenAI — reserved for the final production deployment.
AZURE_OPENAI_ENDPOINT=https://zrahim-4617-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=portfolio-rag-chat
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=portfolio-rag-embeddings

# Azure AI Search.
AZURE_SEARCH_ENDPOINT=https://zohaib-portfolio-rag-search.search.windows.net
AZURE_SEARCH_API_KEY=

# During local development, use the index containing Ollama/Qwen embeddings.
AZURE_SEARCH_INDEX_NAME=portfolio-chunks-dev-ollama

# Retrieval feature flags.
# Set to "false" to bypass the LLM query-rewrite stage
# and send the trimmed original question directly to Azure Search.
QUERY_REWRITE_ENABLED=false

# Backend application settings.
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173

# Use Ollama locally during development.
AI_PROVIDER=ollama

# Local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Local model used to generate answers.
OLLAMA_CHAT_MODEL=qwen3:4b-instruct

# Local model used to generate 1024-dimensional embeddings.
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b